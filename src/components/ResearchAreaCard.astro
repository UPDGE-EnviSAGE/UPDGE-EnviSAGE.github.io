---
import type { ResearchMotif } from "../data/research-architecture";

interface Props {
  title: string;
  description: string;
  methods: readonly string[];
  applications: readonly string[];
  motif?: ResearchMotif;
}

const {
  title,
  description,
  methods,
  applications,
  motif = "grid",
} = Astro.props;

const motifClass = {
  grid: "geo-surface",
  contour: "contour-surface",
  raster: "raster-surface",
}[motif];
---

<article
  class="grid h-full overflow-hidden rounded-card border border-border bg-surface shadow-subtle"
>
  <div
    class:list={["h-20 border-b border-border/70", motifClass]}
    aria-hidden="true"
  >
  </div>
  <div class="p-5">
    <h3 class="text-xl leading-tight font-semibold text-text">{title}</h3>
    <p class="mt-3 text-sm leading-relaxed text-muted">{description}</p>

    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
      <div>
        <h4
          class="text-xs font-semibold tracking-[0.14em] text-brand-green-deep uppercase"
        >
          Methods
        </h4>
        <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
          {methods.map((method) => <li>{method}</li>)}
        </ul>
      </div>
      <div>
        <h4
          class="text-xs font-semibold tracking-[0.14em] text-brand-green-deep uppercase"
        >
          Applications
        </h4>
        <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
          {applications.map((application) => <li>{application}</li>)}
        </ul>
      </div>
    </div>
  </div>
</article>
