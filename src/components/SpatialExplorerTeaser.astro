---
import ButtonLink from "./ButtonLink.astro";
---

<section
  class="overflow-hidden bg-text text-white"
  aria-labelledby="spatial-explorer-title"
>
  <div
    class="mx-auto grid w-full max-w-[var(--content-width-wide)] gap-10 px-5 py-14 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:px-8 lg:py-24"
  >
    <div>
      <p
        class="text-xs font-semibold tracking-[0.16em] text-white/65 uppercase"
      >
        Future Spatial Explorer
      </p>
      <h2
        id="spatial-explorer-title"
        class="mt-3 text-3xl leading-tight font-semibold sm:text-4xl"
      >
        Explore environmental data spatially
      </h2>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/76">
        EnviSAGE will provide interactive visualization of selected research
        datasets and spatial products, beginning with satellite-derived water
        quality and seagrass, coral, and mangrove mapping priorities.
      </p>
      <ButtonLink href="/explorer/" variant="secondary" class="mt-7">
        Spatial Explorer
      </ButtonLink>
    </div>

    <div
      class="relative min-h-[20rem] overflow-hidden rounded-card border border-white/15 bg-white/8"
      aria-hidden="true"
    >
      <div class="absolute inset-0 opacity-85">
        <div class="raster-surface h-full"></div>
      </div>
      <div
        class="absolute inset-x-8 top-10 h-28 rounded-[50%] border border-white/30"
      >
      </div>
      <div
        class="absolute right-10 bottom-9 left-12 h-24 rounded-[45%] border border-white/25"
      >
      </div>
      <div
        class="absolute top-20 right-16 h-20 w-24 rounded-control border border-white/30 bg-brand-blue/20"
      >
      </div>
      <div
        class="absolute bottom-16 left-16 h-16 w-28 rounded-control border border-white/30 bg-brand-green/25"
      >
      </div>
      <div
        class="absolute right-6 bottom-6 rounded-control border border-white/20 bg-text/80 px-3 py-2 text-xs font-semibold text-white/75"
      >
        Abstract spatial placeholder
      </div>
    </div>
  </div>
</section>
