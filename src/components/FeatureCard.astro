---
interface Props {
  title: string;
  description: string;
  href: string;
  linkText: string;
}

const { title, description, href, linkText } = Astro.props;
---

<article class="rounded-card border border-border bg-surface p-5 shadow-subtle">
  <h3 class="text-xl leading-tight font-semibold text-text">{title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-muted">{description}</p>
  <a
    href={href}
    class="mt-5 inline-flex text-sm font-semibold text-brand-blue no-underline hover:text-brand-blue-deep"
  >
    {linkText}
  </a>
</article>
