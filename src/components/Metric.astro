---
interface Props {
  value: string;
  label: string;
  detail?: string;
}

const { value, label, detail } = Astro.props;
---

<div class="rounded-card border border-border bg-surface p-5">
  <p class="font-mono text-3xl leading-none font-semibold text-brand-blue-deep">
    {value}
  </p>
  <p class="mt-3 text-sm font-semibold text-text">{label}</p>
  {detail && <p class="mt-1 text-sm text-muted">{detail}</p>}
</div>
