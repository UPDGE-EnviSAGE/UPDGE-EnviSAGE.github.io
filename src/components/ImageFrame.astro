---
import ResearchVisualPlaceholder from "./ResearchVisualPlaceholder.astro";

interface Props {
  label?: string;
  motif?: "raster" | "contour" | "grid";
  class?: string;
}

const {
  label = "Abstract geospatial visual motif",
  motif = "raster",
  class: className = "",
} = Astro.props;

const isDev = import.meta.env.DEV;
---

<ResearchVisualPlaceholder
  motif={motif}
  label={label}
  class={className}
  aspectClass="aspect-[16/9]"
>
  {
    isDev && (
      <div class="absolute inset-x-4 bottom-4 rounded-control bg-white/85 px-3 py-2 text-xs font-semibold text-muted">
        {label}
      </div>
    )
  }
</ResearchVisualPlaceholder>
