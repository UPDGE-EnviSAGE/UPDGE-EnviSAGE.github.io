---
interface Props {
  label?: string;
  motif?: "raster" | "contour" | "grid";
  class?: string;
}

const {
  label = "Approved imagery placeholder",
  motif = "raster",
  class: className = "",
} = Astro.props;

const motifClass = {
  raster: "raster-surface",
  contour: "contour-surface",
  grid: "geo-surface",
}[motif];
---

<figure
  class:list={[
    "overflow-hidden rounded-card border border-border bg-surface",
    className,
  ]}
>
  <div
    class:list={[
      "flex aspect-[16/9] items-end p-4 text-sm font-semibold text-text",
      motifClass,
    ]}
    role="img"
    aria-label={label}
  >
    <span class="rounded-control bg-white/85 px-3 py-2 text-xs text-muted">
      {label}
    </span>
  </div>
</figure>
