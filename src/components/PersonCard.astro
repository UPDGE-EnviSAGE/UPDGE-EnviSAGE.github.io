---
import { peopleRoleLabels, researchAreaLabels } from "../data/people-directory";

interface Props {
  name: string;
  roles: readonly (keyof typeof peopleRoleLabels)[];
  institutionalPosition?: string;
  shortBio?: string;
  photo?: string;
  researchAreas?: readonly string[];
  profileHref?: string;
}

const {
  name,
  roles,
  institutionalPosition,
  shortBio,
  photo,
  researchAreas = [],
  profileHref,
} = Astro.props;

const initials = name
  .replace(/^(Dr\.|Asst\. Prof\.|Engr\.)\s+/u, "")
  .split(/\s+/u)
  .filter((part) => /^[A-Z]/u.test(part))
  .slice(0, 2)
  .map((part) => part[0])
  .join("");

const readableResearchAreas = researchAreas
  .map((area) => researchAreaLabels[area as keyof typeof researchAreaLabels])
  .filter(Boolean);
---

<article
  class="grid h-full grid-cols-[4rem_1fr] gap-4 rounded-card border border-border bg-surface p-4 shadow-subtle"
>
  {
    photo ? (
      <img
        src={photo}
        alt=""
        class="h-16 w-16 rounded-control object-cover"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div
        class="geo-surface flex h-16 w-16 items-center justify-center rounded-control border border-border text-lg font-semibold text-brand-blue-deep"
        aria-hidden="true"
      >
        {initials}
      </div>
    )
  }

  <div class="min-w-0">
    <h3 class="text-xl leading-tight font-semibold text-text">
      {
        profileHref ? (
          <a
            href={profileHref}
            class="text-text no-underline hover:text-brand-blue-deep"
          >
            {name}
          </a>
        ) : (
          name
        )
      }
    </h3>
    <p class="mt-2 text-sm font-semibold text-brand-green-deep">
      {roles.map((role) => peopleRoleLabels[role]).join(", ")}
    </p>
    {
      institutionalPosition && (
        <p class="mt-2 text-sm leading-relaxed text-muted">
          {institutionalPosition}
        </p>
      )
    }
    {
      shortBio && (
        <p class="mt-3 text-sm leading-relaxed text-muted">{shortBio}</p>
      )
    }
    {
      readableResearchAreas.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Research areas">
          {readableResearchAreas.map((area) => (
            <li class="rounded-control border border-brand-blue/15 bg-brand-blue/10 px-2.5 py-1 text-xs font-semibold text-brand-blue-deep">
              {area}
            </li>
          ))}
        </ul>
      )
    }
    {
      profileHref && (
        <a
          href={profileHref}
          class="mt-5 inline-flex min-h-10 items-center justify-center rounded-control border border-brand-blue bg-brand-blue px-3 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-blue-deep motion-reduce:transition-none"
        >
          View profile
        </a>
      )
    }
  </div>
</article>
