---
interface ConnectionItem {
  title: string;
  description: string;
}

interface Props {
  items: readonly ConnectionItem[];
}

const { items } = Astro.props;
---

<ol class="grid gap-4 lg:grid-cols-5" aria-label="Research discovery model">
  {
    items.map((item, index) => (
      <li class="relative">
        <article class="h-full rounded-card border border-border bg-white p-5 shadow-subtle">
          <p class="text-xs font-semibold tracking-[0.14em] text-brand-green-deep uppercase">
            Step {index + 1}
          </p>
          <h3 class="mt-3 text-lg leading-tight font-semibold text-text">
            {item.title}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            {item.description}
          </p>
        </article>
        {index < items.length - 1 && (
          <span
            class="mx-auto block h-4 w-px bg-border lg:absolute lg:top-1/2 lg:-right-2 lg:mx-0 lg:h-px lg:w-4"
            aria-hidden="true"
          />
        )}
      </li>
    ))
  }
</ol>
