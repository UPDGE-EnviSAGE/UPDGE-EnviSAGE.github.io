---
interface Props {
  title: string;
  description: string;
  researchArea: string;
  status: string;
}

const { title, description, researchArea, status } = Astro.props;
---

<article
  class="flex h-full flex-col rounded-card border border-dashed border-border bg-surface p-5 shadow-subtle"
>
  <p
    class="text-xs font-semibold tracking-[0.14em] text-brand-green-deep uppercase"
  >
    {status}
  </p>
  <h3 class="mt-4 text-xl leading-tight font-semibold text-text">{title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-muted">{description}</p>
  <dl class="mt-5 grid gap-2 text-sm">
    <div>
      <dt class="font-semibold text-text">Research area</dt>
      <dd class="text-muted">{researchArea}</dd>
    </div>
  </dl>
  <a
    href="/projects/"
    class="mt-auto pt-6 text-sm font-semibold text-brand-blue no-underline hover:text-brand-blue-deep"
  >
    View project catalog
  </a>
</article>
