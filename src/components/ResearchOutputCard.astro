---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<article
  class="h-full rounded-card border border-border bg-surface p-5 shadow-subtle"
>
  <h3 class="text-lg leading-tight font-semibold text-text">{title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-muted">{description}</p>
</article>
