---
interface Props {
  size?: "narrow" | "default" | "wide";
  class?: string;
}

const { size = "default", class: className = "" } = Astro.props;

const sizeClass = {
  narrow: "max-w-[var(--content-width-narrow)]",
  default: "max-w-[var(--content-width)]",
  wide: "max-w-[var(--content-width-wide)]",
}[size];
---

<div class:list={["mx-auto w-full px-5 sm:px-6 lg:px-8", sizeClass, className]}>
  <slot />
</div>
