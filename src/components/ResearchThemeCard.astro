---
interface Props {
  title: string;
  description: string;
  motif?: "grid" | "contour" | "raster";
}

const { title, description, motif = "grid" } = Astro.props;

const motifClass = {
  grid: "geo-surface",
  contour: "contour-surface",
  raster: "raster-surface",
}[motif];
---

<article class="rounded-card border border-border bg-surface p-5 shadow-subtle">
  <div
    class:list={[
      "mb-5 h-16 rounded-control border border-border/70",
      motifClass,
    ]}
    aria-hidden="true"
  >
  </div>
  <h3 class="text-xl leading-tight font-semibold text-text">{title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-muted">{description}</p>
</article>
