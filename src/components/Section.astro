---
import Container from "./Container.astro";

interface Props {
  size?: "narrow" | "default" | "wide";
  tone?: "default" | "surface" | "muted" | "dark";
  class?: string;
}

const {
  size = "default",
  tone = "default",
  class: className = "",
} = Astro.props;

const toneClass = {
  default: "",
  surface: "bg-surface",
  muted: "bg-surface-muted",
  dark: "bg-text text-white",
}[tone];
---

<section class:list={["py-14 sm:py-18 lg:py-24", toneClass, className]}>
  <Container size={size}>
    <slot />
  </Container>
</section>
