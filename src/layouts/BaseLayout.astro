---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Environmental Systems Applications of Geomatics Engineering web platform foundation.",
} = Astro.props;

const pageTitle = `${title} | EnviSAGE`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
