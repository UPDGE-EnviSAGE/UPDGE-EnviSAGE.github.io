---
import ButtonLink from "@components/ButtonLink.astro";
import ResearchVisualPlaceholder from "@components/ResearchVisualPlaceholder.astro";
import ResearchThemeCard from "@components/ResearchThemeCard.astro";
import Section from "@components/Section.astro";
import SectionHeading from "@components/SectionHeading.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { exploreLinks, researchThemes } from "../data/homepage";
import { getHomepageMetrics } from "../utils/site-metrics";

const homepageMetrics = await getHomepageMetrics();
---

<BaseLayout
  title="EnviSAGE | Environmental Systems Applications of Geomatics Engineering"
  titleTemplate="plain"
  description="EnviSAGE is the environmental geomatics research laboratory of the UP Department of Geodetic Engineering."
>
  <section class="geo-surface" aria-labelledby="home-title">
    <div
      class="mx-auto grid w-full max-w-[var(--content-width-wide)] gap-8 px-5 py-10 sm:px-6 md:grid-cols-[1.05fr_0.95fr] md:items-center md:py-12 lg:px-8 lg:py-16"
    >
      <div class="max-w-3xl">
        <p
          class="text-xs font-semibold tracking-[0.16em] text-brand-green-deep uppercase"
        >
          UP Department of Geodetic Engineering Research Laboratory
        </p>
        <h1
          id="home-title"
          class="mt-5 text-5xl leading-none font-semibold text-text sm:text-6xl lg:text-7xl"
        >
          EnviSAGE
        </h1>
        <p
          class="mt-5 max-w-2xl text-xl leading-snug font-semibold break-words text-brand-blue-deep sm:text-3xl sm:leading-tight"
        >
          Environmental Systems Applications of Geomatics Engineering
        </p>
        <p
          class="mt-6 max-w-2xl text-base leading-relaxed break-words text-muted sm:text-xl"
        >
          Spatial Understanding for Environmental Sustainability
        </p>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted">
          EnviSAGE is the environmental geomatics research laboratory of the UP
          Department of Geodetic Engineering.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <ButtonLink href="/research/">Explore research</ButtonLink>
          <ButtonLink href="/people/" variant="secondary">
            Meet the laboratory
          </ButtonLink>
          <ButtonLink href="/projects/" variant="ghost"
            >View projects</ButtonLink
          >
        </div>
      </div>

      <ResearchVisualPlaceholder
        motif="raster"
        class="hidden sm:block"
        aspectClass="aspect-[4/3] min-h-[12rem] sm:min-h-[16rem] lg:min-h-[18rem]"
        surfaceClass="flex items-end p-5 sm:p-7"
        label="Abstract geospatial motif representing EnviSAGE environmental research"
      >
        <div
          class="absolute inset-6 rounded-[50%] border border-brand-blue/25"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute top-12 right-8 h-24 w-28 rounded-control border border-brand-blue/25 bg-white/35"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute bottom-20 left-10 h-20 w-32 rounded-control border border-brand-green/30 bg-white/45"
          aria-hidden="true"
        >
        </div>
      </ResearchVisualPlaceholder>
    </div>
  </section>

  <Section size="wide" aria-labelledby="what-envisage-does">
    <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
      <SectionHeading
        id="what-envisage-does"
        eyebrow="What EnviSAGE Does"
        title="Environmental challenges are spatial."
      />
      <div class="max-w-3xl">
        <p class="text-xl leading-relaxed text-text">
          EnviSAGE combines Earth observation, GIS, spatial analytics, modeling,
          field observations, and environmental data science to understand how
          environmental systems change across space and time.
        </p>
      </div>
    </div>
  </Section>

  <Section
    size="wide"
    tone="muted"
    class="border-y border-border"
    aria-labelledby="research-themes"
  >
    <div
      class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between"
    >
      <SectionHeading
        id="research-themes"
        eyebrow="Research Themes"
        title="Geomatics for environmental systems"
        text="Five themes connect the laboratory's work across coastal, ecological, environmental-quality, climate, hazard, urban, and sustainable systems."
      />
      <ButtonLink href="/research/" variant="secondary">
        Explore all research
      </ButtonLink>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        researchThemes.map((theme) => (
          <ResearchThemeCard
            title={theme.title}
            description={theme.description}
            motif={theme.motif}
          />
        ))
      }
    </div>
  </Section>

  <Section size="wide" aria-labelledby="envisage-glance">
    <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
      <SectionHeading
        id="envisage-glance"
        eyebrow="EnviSAGE at a Glance"
        title="Current public research activity"
        text="A concise view of the laboratory's public themes, people, publications, theses, and alumni."
      />
      <dl class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
        {
          homepageMetrics.map((metric) => (
            <div class="border-t border-border pt-4">
              <dt class="text-sm font-semibold leading-snug text-muted">
                {metric.label}
              </dt>
              <dd class="mt-2 font-mono text-3xl leading-none font-semibold text-brand-blue-deep">
                {metric.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <Section
    size="wide"
    tone="surface"
    class="border-y border-border py-12 sm:py-14 lg:py-18"
    aria-labelledby="explore-envisage"
  >
    <div class="grid gap-8 lg:grid-cols-[0.76fr_1.24fr] lg:items-start">
      <SectionHeading
        id="explore-envisage"
        eyebrow="Explore EnviSAGE"
        title="Research, people, outputs, tools, and spatial data"
        text="Explore the laboratory's research, scholarly outputs, people, tools, and environmental spatial data."
      />
      <nav
        class="grid gap-x-6 gap-y-3 sm:grid-cols-2 lg:grid-cols-4"
        aria-label="Explore EnviSAGE"
      >
        {
          exploreLinks.map((link) => (
            <a
              href={link.href}
              class="min-h-11 border-b border-border py-2 text-sm font-semibold text-brand-blue-deep no-underline hover:text-brand-blue hover:underline"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </Section>
</BaseLayout>
