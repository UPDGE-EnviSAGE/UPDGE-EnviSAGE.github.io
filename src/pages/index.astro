---
import BrandLockup from "@components/BrandLockup.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Website Foundation"
  description="The EnviSAGE public website foundation is under development."
>
  <section
    class="flex min-h-screen items-center py-16"
    aria-labelledby="page-title"
  >
    <div
      class="mx-auto w-full max-w-[var(--content-width)] px-5 sm:px-6 lg:px-8"
    >
      <div class="max-w-3xl">
        <p
          class="mb-4 text-xs font-semibold tracking-[0.16em] text-brand-green-deep uppercase"
        >
          Website under development
        </p>
        <h1 id="page-title" class="sr-only">EnviSAGE website foundation</h1>
        <BrandLockup variant="institutional" />
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
          Using Geomatics and geospatial technologies to address environmental
          issues.
        </p>
        <p
          class="mt-6 max-w-2xl rounded-card border border-border bg-surface/85 p-4 text-sm text-muted shadow-subtle"
        >
          Phase 2 establishes the visual identity and design-system foundation.
          This is not the final EnviSAGE homepage.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
