---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Website Foundation"
  description="The EnviSAGE public website foundation is under development."
>
  <section
    class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center px-6 py-16"
    aria-labelledby="page-title"
  >
    <p class="text-sm font-semibold tracking-wide text-teal-700 uppercase">
      EnviSAGE
    </p>
    <h1
      id="page-title"
      class="mt-3 text-4xl font-semibold text-slate-950 sm:text-5xl"
    >
      Environmental Systems Applications of Geomatics Engineering
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-slate-700">
      The EnviSAGE public website foundation is under development. This
      placeholder verifies the Astro, TypeScript, Tailwind, and content
      validation setup for later phases.
    </p>
  </section>
</BaseLayout>
