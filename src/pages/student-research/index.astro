---
import { getCollection } from "astro:content";
import Section from "@components/Section.astro";
import SectionHeading from "@components/SectionHeading.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  createFacultyDirectory,
  getAdviserHref,
} from "../../data/student-research-relationships";
import { topicLabel } from "../../data/student-research";
import {
  formatPersonDisplayName,
  joinDisplayNames,
} from "../../utils/display-names";

const publicTheses = await getCollection(
  "student-research",
  ({ data }) => data.visibility === "public",
);

const publicPeople = await getCollection(
  "people",
  ({ data }) => data.visibility === "public",
);

const facultyDirectory = createFacultyDirectory(publicPeople);

const sortedTheses = publicTheses.sort(
  (first, second) =>
    (second.data.year ?? 0) - (first.data.year ?? 0) ||
    first.data.thesisTitle.localeCompare(second.data.thesisTitle),
);

const thesesByYear = Array.from(
  sortedTheses.reduce((groups, thesis) => {
    const year = String(thesis.data.year ?? "Undated");
    const current = groups.get(year) ?? [];
    current.push(thesis);
    groups.set(year, current);
    return groups;
  }, new Map<string, typeof sortedTheses>()),
);

const advisers = Array.from(
  new Map(
    sortedTheses
      .map((thesis): [string, string | undefined] => [
        formatPersonDisplayName(thesis.data.adviser),
        thesis.data.mainAdviserPerson,
      ])
      .filter(([name]) => Boolean(name)),
  ),
).sort(([first], [second]) => first.localeCompare(second));

const thesisCount = sortedTheses.length;
---

<BaseLayout
  title="Student Research"
  description="EnviSAGE student research connecting theses, advisers, environmental systems, and geospatial methods."
>
  <section class="geo-surface" aria-labelledby="student-research-title">
    <div
      class="mx-auto w-full max-w-[var(--content-width-wide)] px-5 py-10 sm:px-6 lg:px-8 lg:py-16"
    >
      <div class="max-w-3xl">
        <p
          class="text-xs font-semibold tracking-[0.16em] text-brand-green-deep uppercase"
        >
          Student Research
        </p>
        <h1
          id="student-research-title"
          class="mt-5 text-4xl leading-tight font-semibold text-text sm:text-5xl"
        >
          Student Research
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
          Undergraduate theses connected to EnviSAGE faculty, environmental
          systems, and geospatial research methods.
        </p>
      </div>
    </div>
  </section>

  <Section size="wide" aria-labelledby="student-research-catalog">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <div>
        <SectionHeading
          id="student-research-catalog"
          eyebrow="Catalog"
          title="Undergraduate theses"
          text="A growing library of student research advised or co-advised by EnviSAGE faculty."
        />

        {
          thesisCount === 0 ? (
            <div class="mt-8 rounded-card border border-border bg-surface p-6 shadow-subtle">
              <h2 class="text-xl font-semibold text-text">
                No public student research records yet
              </h2>
              <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">
                EnviSAGE is preparing student research entries for this catalog.
              </p>
            </div>
          ) : (
            <div class="mt-10 space-y-12">
              {thesesByYear.map(([year, theses]) => (
                <section aria-labelledby={`student-research-${year}`}>
                  <div class="flex items-end justify-between gap-4 border-b border-border pb-3">
                    <h2
                      id={`student-research-${year}`}
                      class="text-2xl font-semibold text-text"
                    >
                      {year}
                    </h2>
                    <p class="text-sm font-semibold text-muted">
                      {theses.length}{" "}
                      {theses.length === 1 ? "thesis" : "theses"}
                    </p>
                  </div>
                  <div class="mt-4 divide-y divide-border">
                    {theses.map((thesis) => (
                      <article class="py-5">
                        <div class="min-w-0">
                          <p class="text-sm font-semibold text-brand-green-deep">
                            {thesis.data.year} · {thesis.data.program}
                          </p>
                          <h3 class="mt-2 text-xl leading-snug font-semibold text-text">
                            <a
                              href={`/student-research/${thesis.data.slug}/`}
                              class="text-text underline-offset-4 hover:text-brand-blue-deep hover:underline"
                            >
                              {thesis.data.thesisTitle} →
                            </a>
                          </h3>
                          <dl class="mt-3 grid gap-3 text-sm leading-relaxed text-muted sm:grid-cols-2">
                            <div>
                              <dt class="font-semibold text-text">Students</dt>
                              <dd>{joinDisplayNames(thesis.data.students)}</dd>
                            </div>
                            <div>
                              <dt class="font-semibold text-text">
                                Main adviser
                              </dt>
                              <dd>
                                {getAdviserHref(
                                  thesis.data.mainAdviserPerson,
                                  facultyDirectory,
                                ) ? (
                                  <a
                                    href={getAdviserHref(
                                      thesis.data.mainAdviserPerson,
                                      facultyDirectory,
                                    )}
                                    class="font-semibold text-brand-blue-deep underline-offset-4 hover:underline"
                                  >
                                    {formatPersonDisplayName(
                                      thesis.data.adviser,
                                    )}
                                  </a>
                                ) : (
                                  formatPersonDisplayName(thesis.data.adviser)
                                )}
                              </dd>
                            </div>
                          </dl>
                          {thesis.data.researchTopics.length > 0 && (
                            <p class="mt-3 text-sm leading-relaxed text-muted">
                              {thesis.data.researchTopics
                                .map((topic) => topicLabel(topic))
                                .join(", ")}
                            </p>
                          )}
                        </div>
                      </article>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          )
        }
      </div>

      <aside class="lg:pt-24" aria-labelledby="student-research-browse">
        <div class="border-l border-border pl-5">
          <h2
            id="student-research-browse"
            class="text-lg font-semibold text-text"
          >
            Browse
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Grouped by year, newest first.
          </p>
          <dl class="mt-5 space-y-4">
            <div>
              <dt class="text-sm font-semibold text-brand-green-deep">
                Theses
              </dt>
              <dd class="mt-1 text-2xl font-semibold text-text">
                {thesisCount}
              </dd>
            </div>
            {
              advisers.length > 0 && (
                <div>
                  <dt class="text-sm font-semibold text-brand-green-deep">
                    Advisers
                  </dt>
                  <dd class="mt-2">
                    <ul class="space-y-2 text-sm text-muted">
                      {advisers.map(([adviser, adviserSlug]) => (
                        <li>
                          {getAdviserHref(adviserSlug, facultyDirectory) ? (
                            <a
                              href={getAdviserHref(
                                adviserSlug,
                                facultyDirectory,
                              )}
                              class="font-semibold text-brand-blue-deep underline-offset-4 hover:underline"
                            >
                              {adviser}
                            </a>
                          ) : (
                            adviser
                          )}
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )
            }
          </dl>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>
