---
import PreparedSectionPage from "@components/PreparedSectionPage.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Spatial Explorer"
  description="The EnviSAGE Spatial Explorer focuses on selected environmental datasets and spatial products."
>
  <PreparedSectionPage
    title="Spatial Explorer"
    intro="Interactive maps and selected environmental spatial products will be made available through EnviSAGE."
    note="This space will support public spatial understanding of selected environmental research outputs."
    motif="raster"
    links={[
      { href: "/research/", label: "Explore research" },
      { href: "/data/", label: "Explore data", variant: "secondary" },
    ]}
  />
</BaseLayout>
