---
import { getCollection } from "astro:content";
import Section from "@components/Section.astro";
import SectionHeading from "@components/SectionHeading.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getPublicUndergraduateAlumni } from "../../../data/student-research-relationships";

const publicPeople = await getCollection(
  "people",
  ({ data }) => data.visibility === "public",
);

const publicTheses = await getCollection(
  "student-research",
  ({ data }) => data.visibility === "public",
);

const alumni = getPublicUndergraduateAlumni(publicPeople, publicTheses);

const alumniByYear = Array.from(
  alumni.reduce((groups, alumnus) => {
    const year = String(alumnus.thesis?.data.year ?? "Undated");
    const current = groups.get(year) ?? [];
    current.push(alumnus);
    groups.set(year, current);
    return groups;
  }, new Map<string, typeof alumni>()),
).sort(([firstYear], [secondYear]) => Number(secondYear) - Number(firstYear));
---

<BaseLayout
  title="Alumni"
  description="Former undergraduate researchers advised by EnviSAGE faculty."
>
  <section class="geo-surface" aria-labelledby="alumni-title">
    <div
      class="mx-auto w-full max-w-[var(--content-width-wide)] px-5 py-10 sm:px-6 lg:px-8 lg:py-16"
    >
      <div class="max-w-3xl">
        <p
          class="text-xs font-semibold tracking-[0.16em] text-brand-green-deep uppercase"
        >
          People
        </p>
        <h1
          id="alumni-title"
          class="mt-5 text-4xl leading-tight font-semibold text-text sm:text-5xl"
        >
          Alumni
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
          Former undergraduate researchers advised by EnviSAGE faculty, grouped
          by thesis year.
        </p>
      </div>
    </div>
  </section>

  <Section size="wide" aria-labelledby="alumni-directory">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_16rem]">
      <div>
        <SectionHeading
          id="alumni-directory"
          eyebrow="Directory"
          title="Undergraduate research alumni"
          text="Grouped by completion year and sorted alphabetically within each year."
        />

        <div class="mt-8 space-y-10">
          {
            alumniByYear.map(([year, entries]) => (
              <section aria-labelledby={`alumni-${year}`}>
                <div class="flex items-end justify-between gap-4 border-b border-border pb-3">
                  <h2
                    id={`alumni-${year}`}
                    class="text-2xl font-semibold text-text"
                  >
                    {year}
                  </h2>
                  <p class="text-sm font-semibold text-muted">
                    {entries.length} alumn
                    {entries.length === 1 ? "us" : "i"}
                  </p>
                </div>
                <ol class="mt-4 divide-y divide-border">
                  {entries.map(({ displayName, thesis }) => (
                    <li class="py-4">
                      <p class="text-base font-semibold text-text">
                        {displayName}
                      </p>
                      {thesis && (
                        <p class="mt-1 text-sm leading-relaxed text-muted">
                          <a
                            href={`/student-research/${thesis.data.slug}/`}
                            class="font-semibold text-brand-blue-deep underline-offset-4 hover:underline"
                          >
                            {thesis.data.thesisTitle} →
                          </a>
                        </p>
                      )}
                    </li>
                  ))}
                </ol>
              </section>
            ))
          }
        </div>
      </div>

      <aside class="lg:pt-24" aria-labelledby="alumni-summary">
        <div class="border-l border-border pl-5">
          <h2 id="alumni-summary" class="text-lg font-semibold text-text">
            At a glance
          </h2>
          <dl class="mt-5 space-y-4">
            <div>
              <dt class="text-sm font-semibold text-brand-green-deep">
                Alumni
              </dt>
              <dd class="mt-1 text-2xl font-semibold text-text">
                {alumni.length}
              </dd>
            </div>
            <div>
              <dt class="text-sm font-semibold text-brand-green-deep">
                Thesis years
              </dt>
              <dd class="mt-1 text-2xl font-semibold text-text">
                {alumniByYear.length}
              </dd>
            </div>
          </dl>
          <a
            href="/people/"
            class="mt-6 inline-flex min-h-10 items-center text-sm font-semibold text-brand-blue-deep underline-offset-4 hover:underline"
          >
            Back to people
          </a>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>
