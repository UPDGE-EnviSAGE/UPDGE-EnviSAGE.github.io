---
import { getCollection } from "astro:content";
import ButtonLink from "@components/ButtonLink.astro";
import Section from "@components/Section.astro";
import SectionHeading from "@components/SectionHeading.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getPublicUndergraduateAlumni } from "../../../data/student-research-relationships";

const publicPeople = await getCollection(
  "people",
  ({ data }) => data.visibility === "public",
);

const publicTheses = await getCollection(
  "student-research",
  ({ data }) => data.visibility === "public",
);

const alumni = getPublicUndergraduateAlumni(publicPeople, publicTheses);

const alumniByYear = Array.from(
  alumni.reduce((groups, alumnus) => {
    const year = String(alumnus.thesis?.data.year ?? "Reviewed");
    const current = groups.get(year) ?? [];
    current.push(alumnus);
    groups.set(year, current);
    return groups;
  }, new Map<string, typeof alumni>()),
).sort(([firstYear], [secondYear]) => Number(secondYear) - Number(firstYear));
---

<BaseLayout
  title="Alumni"
  description="Public EnviSAGE-affiliated undergraduate research alumni grouped by thesis year."
>
  <section class="geo-surface" aria-labelledby="alumni-title">
    <div
      class="mx-auto w-full max-w-[var(--content-width-wide)] px-5 py-10 sm:px-6 lg:px-8 lg:py-16"
    >
      <div class="max-w-3xl">
        <p
          class="text-xs font-semibold tracking-[0.16em] text-brand-green-deep uppercase"
        >
          People
        </p>
        <h1
          id="alumni-title"
          class="mt-5 text-4xl leading-tight font-semibold text-text sm:text-5xl"
        >
          Alumni
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
          Public EnviSAGE-affiliated undergraduate research alumni, derived from
          reviewed thesis records where EnviSAGE faculty served as main adviser.
        </p>
      </div>
    </div>
  </section>

  <Section size="wide" aria-labelledby="alumni-directory">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <div>
        <SectionHeading
          id="alumni-directory"
          eyebrow="Directory"
          title="Undergraduate research alumni"
          text="Alumni are grouped by completion year and sorted alphabetically by display name within each year."
        />

        <div class="mt-10 space-y-12">
          {
            alumniByYear.map(([year, entries]) => (
              <section aria-labelledby={`alumni-${year}`}>
                <div class="flex items-end justify-between gap-4 border-b border-border pb-3">
                  <h2
                    id={`alumni-${year}`}
                    class="text-2xl font-semibold text-text"
                  >
                    {year}
                  </h2>
                  <p class="text-sm font-semibold text-muted">
                    {entries.length} alumn
                    {entries.length === 1 ? "us" : "i"}
                  </p>
                </div>
                <ol class="mt-5 grid gap-3">
                  {entries.map(({ displayName, thesis }) => (
                    <li class="rounded-card border border-border bg-surface p-4 shadow-subtle">
                      <div class="grid gap-3 md:grid-cols-[minmax(0,1fr)_auto] md:items-start">
                        <div class="min-w-0">
                          <p class="text-base font-semibold text-text">
                            {displayName}
                          </p>
                          <p class="mt-1 text-sm text-muted">
                            BS Geodetic Engineering · Undergraduate Researcher
                          </p>
                          {thesis && (
                            <p class="mt-3 text-sm leading-relaxed text-muted">
                              {thesis.data.thesisTitle}
                            </p>
                          )}
                        </div>
                        {thesis && (
                          <a
                            href={`/student-research/${thesis.data.slug}/`}
                            class="inline-flex min-h-10 items-center justify-center rounded-control border border-brand-blue px-3 py-2 text-sm font-semibold text-brand-blue-deep underline-offset-4 hover:bg-brand-blue/10 hover:underline"
                          >
                            View thesis
                          </a>
                        )}
                      </div>
                    </li>
                  ))}
                </ol>
              </section>
            ))
          }
        </div>
      </div>

      <aside class="lg:pt-24" aria-labelledby="alumni-summary">
        <div
          class="rounded-card border border-border bg-surface p-5 shadow-subtle"
        >
          <h2 id="alumni-summary" class="text-lg font-semibold text-text">
            Directory Summary
          </h2>
          <dl class="mt-5 space-y-4">
            <div>
              <dt class="text-sm font-semibold text-brand-green-deep">
                Public alumni
              </dt>
              <dd class="mt-1 text-2xl font-semibold text-text">
                {alumni.length}
              </dd>
            </div>
            <div>
              <dt class="text-sm font-semibold text-brand-green-deep">
                Source records
              </dt>
              <dd class="mt-1 text-sm leading-relaxed text-muted">
                Reviewed public undergraduate theses with EnviSAGE main-adviser
                affiliation.
              </dd>
            </div>
          </dl>
          <div class="mt-6">
            <ButtonLink href="/people/" variant="secondary">
              Back to people
            </ButtonLink>
          </div>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>
