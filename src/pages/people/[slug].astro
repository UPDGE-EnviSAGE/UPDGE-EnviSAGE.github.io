---
import { getCollection } from "astro:content";
import ButtonLink from "@components/ButtonLink.astro";
import Section from "@components/Section.astro";
import SectionHeading from "@components/SectionHeading.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  getFacultyAdvisingRecords,
  getFacultyAdvisingSummary,
} from "../../data/student-research-relationships";
import {
  peopleRoleLabels,
  researchAreaLabels,
} from "../../data/people-directory";
import { joinDisplayNames } from "../../utils/display-names";

export async function getStaticPaths() {
  const people = await getCollection(
    "people",
    ({ data }) =>
      data.visibility === "public" &&
      data.membershipStatus === "active" &&
      Boolean(data.shortBio) &&
      (data.categories.includes("leadership") ||
        data.categories.includes("faculty-affiliate")),
  );

  return people.map((person) => ({
    params: { slug: person.data.slug },
    props: { person },
  }));
}

const { person } = Astro.props;
const profile = person.data;
const publicTheses = await getCollection(
  "student-research",
  ({ data }) => data.visibility === "public",
);
const advisingRecords = getFacultyAdvisingRecords(publicTheses, profile.slug);
const advisingSummary = getFacultyAdvisingSummary(advisingRecords);

const initials = profile.name
  .replace(/^(Dr\.|Asst\. Prof\.|Engr\.)\s+/u, "")
  .split(/\s+/u)
  .filter((part: string) => /^[A-Z]/u.test(part))
  .slice(0, 2)
  .map((part: string) => part[0])
  .join("");

const bioParagraphs = profile.shortBio
  ? profile.shortBio.split(/\n\s*\n/u).filter(Boolean)
  : [];

const areaLabels = profile.researchAreas
  .map(
    (area: string) =>
      researchAreaLabels[area as keyof typeof researchAreaLabels],
  )
  .filter(Boolean);

const contributionGroups = [
  { label: "Projects", items: profile.projects },
  { label: "Publications", items: profile.publications },
  { label: "Student Research", items: profile.studentResearch },
  { label: "Datasets", items: profile.datasets },
  { label: "Software", items: profile.tools },
].filter((group) => group.items.length > 0);

const professionalLinks = [
  profile.googleScholar && {
    label: "Google Scholar",
    href: profile.googleScholar,
  },
  profile.orcid && {
    label: "ORCID",
    href: `https://orcid.org/${profile.orcid}`,
  },
  profile.personalWebsite && {
    label: "Personal website",
    href: profile.personalWebsite,
  },
  profile.github && {
    label: "GitHub",
    href: profile.github,
  },
].filter(Boolean) as { label: string; href: string }[];

const roleText = profile.envisageRoles
  .map((role: keyof typeof peopleRoleLabels) => peopleRoleLabels[role])
  .join(", ");

const description = `${profile.name} faculty profile for Environmental Systems Applications of Geomatics Engineering at the UP Department of Geodetic Engineering.`;
---

<BaseLayout title={profile.name} description={description}>
  <section class="geo-surface" aria-labelledby="profile-title">
    <div
      class="mx-auto grid w-full max-w-[var(--content-width-wide)] gap-8 px-5 py-10 sm:px-6 lg:grid-cols-[18rem_1fr] lg:items-center lg:px-8 lg:py-16"
    >
      {
        profile.photo ? (
          <img
            src={profile.photo}
            alt=""
            class="aspect-square w-full max-w-64 rounded-card border border-border object-cover shadow-subtle"
            decoding="async"
          />
        ) : (
          <div
            class="geo-surface flex aspect-square w-full max-w-64 items-center justify-center rounded-card border border-border text-5xl font-semibold text-brand-blue-deep shadow-subtle"
            aria-hidden="true"
          >
            {initials}
          </div>
        )
      }

      <div class="max-w-3xl">
        <p
          class="text-xs font-semibold tracking-[0.16em] text-brand-green-deep uppercase"
        >
          Faculty Profile
        </p>
        <h1
          id="profile-title"
          class="mt-5 text-4xl leading-tight font-semibold text-text sm:text-5xl"
        >
          {profile.name}
        </h1>
        {
          profile.institutionalPosition && (
            <p class="mt-4 text-lg font-semibold text-brand-blue-deep">
              {profile.institutionalPosition}
            </p>
          )
        }
        <p class="mt-2 text-base font-semibold text-brand-green-deep">
          {roleText}
        </p>
        <div class="mt-6 space-y-4 text-lg leading-relaxed text-muted">
          {bioParagraphs.map((paragraph: string) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <Section size="wide" aria-labelledby="profile-summary">
    <SectionHeading
      id="profile-summary"
      eyebrow="Faculty Summary"
      title="Public profile record"
      text="A source-based faculty record for the EnviSAGE public platform."
    />
    <dl class="mt-8 grid gap-4 md:grid-cols-3">
      <div
        class="rounded-card border border-border bg-surface p-5 shadow-subtle"
      >
        <dt class="text-sm font-semibold text-brand-green-deep">
          EnviSAGE role
        </dt>
        <dd class="mt-2 text-base text-text">{roleText}</dd>
      </div>
      <div
        class="rounded-card border border-border bg-surface p-5 shadow-subtle"
      >
        <dt class="text-sm font-semibold text-brand-green-deep">UP position</dt>
        <dd class="mt-2 text-base text-text">
          {profile.institutionalPosition}
        </dd>
      </div>
      <div
        class="rounded-card border border-border bg-surface p-5 shadow-subtle"
      >
        <dt class="text-sm font-semibold text-brand-green-deep">
          Public status
        </dt>
        <dd class="mt-2 text-base text-text">Active public faculty record</dd>
      </div>
    </dl>
  </Section>

  <Section
    size="wide"
    tone="muted"
    class="border-y border-border"
    aria-labelledby="profile-interests"
  >
    <div class="grid gap-10 lg:grid-cols-[1fr_0.85fr]">
      <div>
        <SectionHeading
          id="profile-interests"
          eyebrow="Research Interests"
          title="Verified faculty interests"
          text="Specific interests are stored separately from broad EnviSAGE research areas."
        />
        <ul class="mt-8 flex flex-wrap gap-2">
          {
            profile.researchInterests.map((interest: string) => (
              <li class="rounded-control border border-brand-blue/15 bg-white px-3 py-2 text-sm font-semibold text-brand-blue-deep">
                {interest}
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-2xl leading-tight font-semibold text-text">
          Research Areas
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Broad EnviSAGE navigation areas connected to this faculty profile.
        </p>
        <ul class="mt-6 space-y-3">
          {
            areaLabels.map((area: string) => (
              <li class="rounded-card border border-border bg-surface p-4 text-sm font-semibold text-text shadow-subtle">
                {area}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  {
    advisingRecords.length > 0 && (
      <Section size="wide" aria-labelledby="profile-advising">
        <div class="grid gap-10 lg:grid-cols-[18rem_minmax(0,1fr)]">
          <aside
            class="rounded-card border border-border bg-surface p-5 shadow-subtle"
            aria-labelledby="profile-advising-summary"
          >
            <h2
              id="profile-advising-summary"
              class="text-lg font-semibold text-text"
            >
              Advising Summary
            </h2>
            <dl class="mt-5 space-y-4">
              <div>
                <dt class="text-sm font-semibold text-brand-green-deep">
                  Theses advised
                </dt>
                <dd class="mt-1 text-2xl font-semibold text-text">
                  {advisingSummary.thesesAdvised}
                </dd>
              </div>
              <div>
                <dt class="text-sm font-semibold text-brand-green-deep">
                  Students advised
                </dt>
                <dd class="mt-1 text-2xl font-semibold text-text">
                  {advisingSummary.studentsAdvised}
                </dd>
              </div>
              <div>
                <dt class="text-sm font-semibold text-brand-green-deep">
                  Role split
                </dt>
                <dd class="mt-1 text-sm leading-relaxed text-muted">
                  {advisingSummary.mainAdvised} main-advised ·{" "}
                  {advisingSummary.coAdvised} co-advised
                </dd>
              </div>
            </dl>
          </aside>

          <div>
            <SectionHeading
              id="profile-advising"
              eyebrow="Student Research"
              title="Undergraduate Research Advising"
              text="Reviewed public undergraduate theses where this faculty member served as main adviser or co-adviser."
            />
            <ol class="mt-8 grid gap-4">
              {advisingRecords.map(({ thesis, role }) => (
                <li class="rounded-card border border-border bg-surface p-5 shadow-subtle">
                  <p class="text-sm font-semibold text-brand-green-deep">
                    {thesis.data.year ?? "Undated"} · {role}
                  </p>
                  <h3 class="mt-2 text-lg leading-snug font-semibold text-text">
                    {thesis.data.thesisTitle}
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-muted">
                    Students: {joinDisplayNames(thesis.data.students)}
                  </p>
                  <a
                    href={`/student-research/${thesis.data.slug}/`}
                    class="mt-4 inline-flex min-h-10 items-center justify-center rounded-control border border-brand-blue px-3 py-2 text-sm font-semibold text-brand-blue-deep underline-offset-4 hover:bg-brand-blue/10 hover:underline"
                  >
                    View thesis
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </Section>
    )
  }

  <Section size="wide" aria-labelledby="profile-role">
    <div class="grid gap-10 lg:grid-cols-[1fr_0.8fr]">
      <div>
        <SectionHeading
          id="profile-role"
          eyebrow="EnviSAGE Role"
          title="Role in the laboratory platform"
          text={`${profile.name} is represented as ${roleText.toLowerCase()} in the EnviSAGE people directory.`}
        />
        <p class="mt-6 max-w-3xl text-base leading-relaxed text-muted">
          This page is the canonical public faculty profile for the EnviSAGE
          website. Reviewed student research relationships are derived from
          public thesis records rather than manually hardcoded into faculty
          records.
        </p>
      </div>

      {
        professionalLinks.length > 0 && (
          <aside
            class="rounded-card border border-border bg-surface p-5 shadow-subtle"
            aria-labelledby="profile-links"
          >
            <h2 id="profile-links" class="text-xl font-semibold text-text">
              Professional Links
            </h2>
            <ul class="mt-5 space-y-3">
              {professionalLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="font-semibold text-brand-blue-deep underline-offset-4 hover:underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </Section>

  {
    contributionGroups.length > 0 && (
      <Section
        size="wide"
        tone="muted"
        class="border-y border-border"
        aria-labelledby="profile-contributions"
      >
        <SectionHeading
          id="profile-contributions"
          eyebrow="Research Contributions"
          title="Reviewed public records"
          text="These connections are generated only from reviewed public content records."
        />
        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {contributionGroups.map((group) => (
            <article class="rounded-card border border-border bg-surface p-5 shadow-subtle">
              <h3 class="text-lg font-semibold text-text">{group.label}</h3>
              <p class="mt-2 text-sm text-muted">
                {group.items.length} reviewed record
                {group.items.length === 1 ? "" : "s"}
              </p>
            </article>
          ))}
        </div>
      </Section>
    )
  }

  <Section size="wide" class="contour-surface" aria-labelledby="profile-cta">
    <div class="max-w-3xl">
      <p
        class="text-xs font-semibold tracking-[0.16em] text-brand-green-deep uppercase"
      >
        Continue Exploring
      </p>
      <h2
        id="profile-cta"
        class="mt-3 text-3xl leading-tight font-semibold text-text sm:text-4xl"
      >
        Explore the people and research areas connected to EnviSAGE.
      </h2>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <ButtonLink href="/people/">Back to people</ButtonLink>
        <ButtonLink href="/research/" variant="secondary">
          Explore research
        </ButtonLink>
      </div>
    </div>
  </Section>
</BaseLayout>
