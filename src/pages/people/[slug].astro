---
import { getCollection } from "astro:content";
import ButtonLink from "@components/ButtonLink.astro";
import Section from "@components/Section.astro";
import SectionHeading from "@components/SectionHeading.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  getFacultyAdvisingRecords,
  getFacultyAdvisingSummary,
} from "../../data/student-research-relationships";
import { peopleRoleLabels } from "../../data/people-directory";
import { joinDisplayNames } from "../../utils/display-names";

export async function getStaticPaths() {
  const people = await getCollection(
    "people",
    ({ data }) =>
      data.visibility === "public" &&
      data.membershipStatus === "active" &&
      Boolean(data.shortBio) &&
      (data.categories.includes("leadership") ||
        data.categories.includes("faculty-affiliate")),
  );

  return people.map((person) => ({
    params: { slug: person.data.slug },
    props: { person },
  }));
}

const { person } = Astro.props;
const profile = person.data;
const publicTheses = await getCollection(
  "student-research",
  ({ data }) => data.visibility === "public",
);
const advisingRecords = getFacultyAdvisingRecords(publicTheses, profile.slug);
const advisingSummary = getFacultyAdvisingSummary(advisingRecords);

const initials = profile.name
  .replace(/^(Dr\.|Asst\. Prof\.|Engr\.)\s+/u, "")
  .split(/\s+/u)
  .filter((part: string) => /^[A-Z]/u.test(part))
  .slice(0, 2)
  .map((part: string) => part[0])
  .join("");

const bioParagraphs = profile.shortBio
  ? profile.shortBio.split(/\n\s*\n/u).filter(Boolean)
  : [];

const contributionGroups = [
  { label: "Projects", items: profile.projects },
  { label: "Publications", items: profile.publications },
  { label: "Student Research", items: profile.studentResearch },
  { label: "Datasets", items: profile.datasets },
  { label: "Software", items: profile.tools },
].filter((group) => group.items.length > 0);

const professionalLinks = [
  profile.googleScholar && {
    label: "Google Scholar",
    href: profile.googleScholar,
  },
  profile.orcid && {
    label: "ORCID",
    href: `https://orcid.org/${profile.orcid}`,
  },
  profile.personalWebsite && {
    label: "Personal website",
    href: profile.personalWebsite,
  },
  profile.github && {
    label: "GitHub",
    href: profile.github,
  },
].filter(Boolean) as { label: string; href: string }[];

const roleText = profile.envisageRoles
  .map((role: keyof typeof peopleRoleLabels) => peopleRoleLabels[role])
  .join(", ");

const description = `${profile.name} faculty profile for Environmental Systems Applications of Geomatics Engineering at the UP Department of Geodetic Engineering.`;

const advisingRecordsByYear = Array.from(
  advisingRecords.reduce((groups, record) => {
    const year = String(record.thesis.data.year ?? "Undated");
    const current = groups.get(year) ?? [];
    current.push(record);
    groups.set(year, current);
    return groups;
  }, new Map<string, typeof advisingRecords>()),
);
---

<BaseLayout title={profile.name} description={description}>
  <section class="geo-surface" aria-labelledby="profile-title">
    <div
      class="mx-auto grid w-full max-w-[var(--content-width-wide)] gap-8 px-5 py-10 sm:px-6 lg:grid-cols-[18rem_1fr] lg:items-center lg:px-8 lg:py-16"
    >
      {
        profile.photo ? (
          <img
            src={profile.photo}
            alt=""
            class="aspect-square w-full max-w-64 rounded-card border border-border object-cover shadow-subtle"
            decoding="async"
          />
        ) : (
          <div
            class="geo-surface flex aspect-square w-full max-w-64 items-center justify-center rounded-card border border-border text-5xl font-semibold text-brand-blue-deep shadow-subtle"
            aria-hidden="true"
          >
            {initials}
          </div>
        )
      }

      <div class="max-w-3xl">
        <p
          class="text-xs font-semibold tracking-[0.16em] text-brand-green-deep uppercase"
        >
          Faculty Profile
        </p>
        <h1
          id="profile-title"
          class="mt-5 text-4xl leading-tight font-semibold text-text sm:text-5xl"
        >
          {profile.name}
        </h1>
        {
          profile.institutionalPosition && (
            <p class="mt-4 text-lg font-semibold text-brand-blue-deep">
              {profile.institutionalPosition}
            </p>
          )
        }
        <p class="mt-2 text-base font-semibold text-brand-green-deep">
          {roleText}
        </p>
        <div class="mt-6 space-y-4 text-lg leading-relaxed text-muted">
          {bioParagraphs.map((paragraph: string) => <p>{paragraph}</p>)}
        </div>
        {
          professionalLinks.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
              {professionalLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm font-semibold text-brand-blue-deep underline-offset-4 hover:underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </section>

  <Section
    size="wide"
    tone="muted"
    class="border-y border-border"
    aria-labelledby="profile-interests"
  >
    <div class="max-w-4xl">
      <SectionHeading
        id="profile-interests"
        eyebrow="Expertise"
        title="Research interests"
        text="Faculty-specific interests and expertise."
      />
      <p class="mt-6 text-base leading-relaxed text-muted">
        {profile.researchInterests.join(", ")}.
      </p>
    </div>
  </Section>

  {
    advisingRecords.length > 0 && (
      <Section size="wide" aria-labelledby="profile-advising">
        <div class="grid gap-8 lg:grid-cols-[16rem_minmax(0,1fr)]">
          <aside
            class="border-l border-border pl-5"
            aria-labelledby="profile-advising-summary"
          >
            <h2
              id="profile-advising-summary"
              class="text-lg font-semibold text-text"
            >
              Advising Summary
            </h2>
            <dl class="mt-5 space-y-4">
              <div>
                <dt class="text-sm font-semibold text-brand-green-deep">
                  Theses advised
                </dt>
                <dd class="mt-1 text-2xl font-semibold text-text">
                  {advisingSummary.thesesAdvised}
                </dd>
              </div>
              <div>
                <dt class="text-sm font-semibold text-brand-green-deep">
                  Students advised
                </dt>
                <dd class="mt-1 text-2xl font-semibold text-text">
                  {advisingSummary.studentsAdvised}
                </dd>
              </div>
              <div>
                <dt class="text-sm font-semibold text-brand-green-deep">
                  Role split
                </dt>
                <dd class="mt-1 text-sm leading-relaxed text-muted">
                  {advisingSummary.mainAdvised} main-advised ·{" "}
                  {advisingSummary.coAdvised} co-advised
                </dd>
              </div>
            </dl>
          </aside>

          <div>
            <SectionHeading
              id="profile-advising"
              eyebrow="Student Research"
              title="Undergraduate research"
              text="Undergraduate theses advised and co-advised."
            />
            <p class="mt-5 text-base font-semibold text-text">
              {advisingSummary.thesesAdvised} theses ·{" "}
              {advisingSummary.studentsAdvised} students advised
            </p>
            <div class="mt-6 space-y-3">
              {advisingRecordsByYear.map(([year, records], index) => (
                <details
                  class="group border-b border-border pb-3"
                  open={index === 0}
                >
                  <summary
                    class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 rounded-control px-1 text-left text-lg font-semibold text-text marker:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
                    aria-label={`${year}, ${records.length} ${records.length === 1 ? "thesis" : "theses"}`}
                  >
                    <span>{year}</span>
                    <span class="text-sm font-semibold text-muted">
                      {records.length}{" "}
                      {records.length === 1 ? "thesis" : "theses"}
                    </span>
                  </summary>
                  <ol class="mt-2 divide-y divide-border">
                    {records.map(({ thesis, role }) => (
                      <li class="py-4">
                        <p class="text-xs font-semibold tracking-[0.12em] text-brand-green-deep uppercase">
                          {role}
                        </p>
                        <h3 class="mt-1 text-base leading-snug font-semibold text-text">
                          <a
                            href={`/student-research/${thesis.data.slug}/`}
                            class="text-text underline-offset-4 hover:text-brand-blue-deep hover:underline"
                          >
                            {thesis.data.thesisTitle} →
                          </a>
                        </h3>
                        <p class="mt-2 text-sm leading-relaxed text-muted">
                          {joinDisplayNames(thesis.data.students)}
                        </p>
                      </li>
                    ))}
                  </ol>
                </details>
              ))}
            </div>
          </div>
        </div>
      </Section>
    )
  }

  {
    contributionGroups.length > 0 && (
      <Section
        size="wide"
        tone="muted"
        class="border-y border-border"
        aria-labelledby="profile-contributions"
      >
        <SectionHeading
          id="profile-contributions"
          eyebrow="Research Contributions"
          title="Research contributions"
          text="Selected EnviSAGE research connections."
        />
        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {contributionGroups.map((group) => (
            <article class="rounded-card border border-border bg-surface p-5 shadow-subtle">
              <h3 class="text-lg font-semibold text-text">{group.label}</h3>
              <p class="mt-2 text-sm text-muted">
                {group.items.length} item
                {group.items.length === 1 ? "" : "s"}
              </p>
            </article>
          ))}
        </div>
      </Section>
    )
  }

  <Section size="wide" class="contour-surface" aria-labelledby="profile-cta">
    <div class="max-w-3xl">
      <p
        class="text-xs font-semibold tracking-[0.16em] text-brand-green-deep uppercase"
      >
        Continue Exploring
      </p>
      <h2
        id="profile-cta"
        class="mt-3 text-3xl leading-tight font-semibold text-text sm:text-4xl"
      >
        Explore the people and research areas connected to EnviSAGE.
      </h2>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <ButtonLink href="/people/">Back to people</ButtonLink>
        <ButtonLink href="/research/" variant="secondary">
          Explore research
        </ButtonLink>
      </div>
    </div>
  </Section>
</BaseLayout>
