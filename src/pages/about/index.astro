---
import ButtonLink from "@components/ButtonLink.astro";
import InstitutionalLogoRow from "@components/InstitutionalLogoRow.astro";
import ResearchVisualPlaceholder from "@components/ResearchVisualPlaceholder.astro";
import Section from "@components/Section.astro";
import SectionHeading from "@components/SectionHeading.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="About"
  description="About EnviSAGE, the environmental geomatics research laboratory of the UP Department of Geodetic Engineering."
>
  <section class="geo-surface" aria-labelledby="about-title">
    <div
      class="mx-auto grid w-full max-w-[var(--content-width-wide)] gap-8 px-5 py-10 sm:px-6 md:grid-cols-[0.95fr_1.05fr] md:items-center lg:px-8 lg:py-16"
    >
      <div class="max-w-3xl">
        <p
          class="text-xs font-semibold tracking-[0.16em] text-brand-green-deep uppercase"
        >
          Identity
        </p>
        <h1
          id="about-title"
          class="mt-5 text-3xl leading-tight font-semibold break-words text-text sm:text-5xl"
        >
          Environmental Systems Applications of Geomatics Engineering (EnviSAGE)
        </h1>
        <p
          class="mt-5 max-w-2xl text-xl leading-snug font-semibold break-words text-brand-blue-deep sm:text-3xl sm:leading-tight"
        >
          Spatial Understanding for Environmental Sustainability
        </p>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
          EnviSAGE is the environmental geomatics research laboratory of the UP
          Department of Geodetic Engineering.
        </p>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted">
          It sits within the University of the Philippines Diliman, College of
          Engineering, Department of Geodetic Engineering.
        </p>
      </div>

      <ResearchVisualPlaceholder
        motif="contour"
        class="hidden sm:block"
        aspectClass="aspect-[4/3] min-h-[12rem] sm:min-h-[16rem] lg:min-h-[17rem]"
        label="Abstract geospatial motif representing environmental systems"
      >
        <div
          class="absolute inset-8 rounded-[50%] border border-brand-blue/25"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute top-12 right-12 h-24 w-32 rounded-control border border-brand-green/30 bg-white/35"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute bottom-12 left-12 h-20 w-28 rounded-control border border-brand-blue/25 bg-white/45"
          aria-hidden="true"
        >
        </div>
      </ResearchVisualPlaceholder>
    </div>
  </section>

  <Section size="wide" aria-labelledby="mission">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <SectionHeading
        id="mission"
        eyebrow="Mission"
        title="Research for environmental sustainability"
      />
      <div class="max-w-3xl">
        <p class="text-xl leading-relaxed text-text">
          EnviSAGE advances environmental sustainability through research in
          Geomatics Engineering, Earth observation, spatial analysis,
          environmental modeling, and geospatial data science.
        </p>
        <p class="mt-5 text-base leading-relaxed text-muted">
          The laboratory also mentors students as developing researchers and
          supports training, extension, and collaboration where spatial evidence
          can help communities and institutions understand environmental change.
        </p>
      </div>
    </div>
  </Section>

  <Section
    size="wide"
    tone="muted"
    class="border-y border-border"
    aria-labelledby="institutional-home"
  >
    <div class="grid gap-8 lg:grid-cols-[0.78fr_1.22fr] lg:items-start">
      <SectionHeading
        id="institutional-home"
        eyebrow="Institutional Home"
        title="Rooted in UP Diliman, Engineering, and Geodetic Engineering"
        text="EnviSAGE is based in the University of the Philippines Diliman, College of Engineering, Department of Geodetic Engineering."
      />
      <InstitutionalLogoRow />
    </div>
  </Section>

  <Section size="wide" aria-labelledby="how-envisage-thinks">
    <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
      <div>
        <p
          class="text-xs font-semibold tracking-[0.16em] text-brand-green-deep uppercase"
        >
          How EnviSAGE Thinks
        </p>
        <h2
          id="how-envisage-thinks"
          class="mt-3 text-3xl leading-tight font-semibold text-text sm:text-4xl"
        >
          Environmental challenges are spatial.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          Environmental change unfolds across places, scales, and time.
          Geomatics Engineering helps measure, connect, and communicate those
          relationships.
        </p>
        <h3 class="mt-8 text-2xl leading-tight font-semibold text-text">
          Systems thinking through spatial evidence
        </h3>
        <p class="mt-4 text-base leading-relaxed text-muted">
          EnviSAGE brings together maps, satellite observations, field
          measurements, model outputs, and spatial analysis to understand linked
          conditions across land, water, atmosphere, ecosystems, infrastructure,
          and society.
        </p>
      </div>

      <ResearchVisualPlaceholder
        motif="grid"
        aspectClass="aspect-[4/3]"
        label="Abstract coordinate-grid motif for Geomatics research"
      />
    </div>
  </Section>

  <Section size="wide" aria-labelledby="research-community">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <SectionHeading
        id="research-community"
        eyebrow="Research Community"
        title="People, projects, and student research connected by environmental questions"
        text="EnviSAGE brings together faculty, researchers, students, and collaborators working with spatial evidence for environmental understanding."
      />
      <div class="max-w-3xl">
        <p class="text-base leading-relaxed text-muted">
          Explore the laboratory's research themes, meet the current community,
          and browse student research connected to EnviSAGE faculty advising.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <ButtonLink href="/research/">Explore research</ButtonLink>
          <ButtonLink href="/people/" variant="secondary">
            Meet the laboratory
          </ButtonLink>
          <ButtonLink href="/student-research/" variant="ghost">
            Student research
          </ButtonLink>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
